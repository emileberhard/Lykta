{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Config/Lykta.xcconfig" },
    { "name": "Release", "file": "Config/Lykta.xcconfig" },
  ],
  "localizations": {
    "development": "en",
  },
  "packages": [
    {
      "kind": "local",
      "path": "../Core",
    },
  ],
  "files": [
    { "kind": "folder", "path": "App", "target-membership": [ "Lykta" ] },
    { "kind": "folder", "path": "Widgets", "target-membership": [ "LyktaWidgets" ] },
    { "kind": "folder", "path": "Rendering", "target-membership": [ "Lykta", "LyktaWidgets" ] },
    { "path": "../Gateway/Sources/LyktaGateway/Skill/examples", "type": "folder", "target-membership": [ "Lykta/resources" ] },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Lykta.xcconfig" },
        { "path": "App.plist" },
        { "path": "Widgets.plist" },
        { "path": "Lykta.entitlements" },
      ],
    }, {
      "kind": "group",
      "path": "Products",
      "children": [
        { "path": "Lykta.app", "id": "LYKTAAPPPRODUCT000000001", "type": "wrapper.application" },
        { "path": "LyktaWidgets.appex", "id": "LYKTAWIDGETSPRODUCT00001", "type": "wrapper.app-extension", "target-membership": [ { "build-phase": "Lykta/copy/Embed Foundation Extensions", "code-sign-on-copy": true } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Lykta",
      "id": "LYKTAAPPTARGET0000000001",
      "product": "Products/Lykta.app",
      "product-type": "application",
      "dependencies": [
        "LyktaWidgets",
        { "kind": "package", "product-name": "LyktaCore" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "LyktaCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "Config/Lykta.entitlements",
        "INFOPLIST_FILE": "Config/App.plist",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(LYKTA_BUNDLE_ID)",
        "PRODUCT_NAME": "Lykta",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS": [
          "$(inherited)",
          "LYKTA_APP",
        ],
      },
    }, {
      "name": "LyktaWidgets",
      "id": "LYKTAWIDGETSTARGET000001",
      "product": "Products/LyktaWidgets.appex",
      "product-type": "app-extension",
      "dependencies": [
        { "kind": "package", "product-name": "LyktaCore" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "LyktaCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "INFOPLIST_FILE": "Config/Widgets.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(LYKTA_BUNDLE_ID).widgets",
        "PRODUCT_NAME": "LyktaWidgets",
        "SKIP_INSTALL": "YES",
      },
    },
  ],
}
