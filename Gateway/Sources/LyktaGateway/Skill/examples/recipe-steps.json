{
  "title": "Cooking shakshuka",
  "layout": {
    "parts": {
      "next": {
        "button": "next",
        "label": {
          "concat": ["Next ", {"symbol": "chevron.right"}],
          "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"foreground": "white"}]
        },
        "style": "borderedProminent",
        "add": {"step": 1},
        "modifiers": [{"tint": "#C8432B"}]
      },
      "stop": {
        "concat": [{"symbol": "stop.fill"}, " Stop"],
        "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"accessibilityLabel": "Stop the timer"}]
      },
      "start": {
        "concat": [{"symbol": "timer"}, " Start"],
        "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"accessibilityLabel": "Start the timer"}]
      }
    },
    "lockScreen": {
      "vstack": [
        {
          "hstack": [
            {
              "text": "{{dish}}",
              "modifiers": [
                {"font": "caption"},
                {"fontWeight": "bold"},
                {"textCase": "uppercase"},
                {"tracking": 1.5},
                {"foreground": "#C8432B"}
              ]
            },
            {"text": "serves {{serves}}", "modifiers": [{"font": "caption"}, {"italic": true}, {"foreground": "#8A7462"}]},
            {"spacer": true},
            {
              "text": "{{step}} of {{of}}",
              "modifiers": [{"font": "caption"}, {"italic": true}, {"monospacedDigit": true}, {"foreground": "#8A7462"}]
            },
            {
              "gauge": "{{step}}",
              "max": "{{of}}",
              "style": "linearCapacity",
              "modifiers": [{"tint": "#C8432B"}, {"frame": {"width": 54}}]
            }
          ],
          "spacing": 6,
          "modifiers": [{"fontDesign": "serif"}]
        },
        {
          "hstack": [
            {
              "text": "{{step}}",
              "modifiers": [
                {"font": 50},
                {"fontWeight": "bold"},
                {"fontDesign": "serif"},
                {"foreground": "#C8432B"},
                {"contentTransition": {"numericText": "{{step}}"}},
                {"frame": {"width": 34, "alignment": "leading"}}
              ]
            },
            {
              "text": "{{steps[step].text}}",
              "modifiers": [
                {"font": "title3"},
                {"fontWeight": "medium"},
                {"fontDesign": "serif"},
                {"lineLimit": 3},
                {"minimumScaleFactor": 0.8},
                {"frame": {"maxWidth": "infinity", "alignment": "leading"}},
                {"transition": [{"push": "trailing"}, "opacity"]},
                {"id": "{{step}}"}
              ]
            },
            {
              "if": "{{timer.on}}",
              "then": {
                "zstack": [
                  {
                    "progress": ["{{timer.start}}", "{{timer.end}}"],
                    "style": "circular",
                    "countsDown": true,
                    "modifiers": [{"tint": "#C8432B"}]
                  },
                  {
                    "date": "{{timer.end}}",
                    "style": "timer",
                    "modifiers": [
                      {"font": 11},
                      {"bold": true},
                      {"monospacedDigit": true},
                      {"multilineTextAlignment": "center"},
                      {"frame": {"width": 38}}
                    ]
                  }
                ],
                "modifiers": [{"frame": {"width": 50, "height": 50}}, {"transition": [{"push": "trailing"}, "opacity"]}]
              }
            }
          ],
          "alignment": "center",
          "spacing": 10,
          "modifiers": [{"animation": {"curve": "smooth", "value": "{{step}}"}}, {"animation": {"curve": "bouncy", "value": "{{timer.end}}"}}]
        },
        {
          "hstack": [
            {
              "if": "{{steps[step].first}}",
              "then": {
                "concat": [{"symbol": "flame.fill"}, " Let's cook"],
                "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"fontDesign": "serif"}, {"foreground": "#8A7462"}]
              },
              "else": {
                "button": "back",
                "label": {"concat": [{"symbol": "chevron.left"}, " Back"], "modifiers": [{"font": "subheadline"}]},
                "style": "bordered",
                "add": {"step": -1},
                "modifiers": [{"tint": "#8A7462"}]
              }
            },
            {"spacer": true},
            {
              "if": "{{timer.on}}",
              "then": {
                "button": "stop-timer",
                "label": {"use": "stop"},
                "style": "bordered",
                "set": {"timer.on": false},
                "modifiers": [{"tint": "#C8432B"}]
              },
              "else": {
                "if": "{{steps[step].timed}}",
                "then": {
                  "button": "start-timer",
                  "label": {"use": "start"},
                  "style": "bordered",
                  "set": {"timer.on": true},
                  "now": {"timer.start": 0, "timer.end": "{{steps[step].seconds}}"},
                  "modifiers": [{"tint": "#C8432B"}]
                }
              }
            },
            {
              "if": "{{steps[step].last}}",
              "then": {
                "concat": [{"symbol": "fork.knife"}, " Enjoy"],
                "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"fontDesign": "serif"}, {"foreground": "#C8432B"}]
              },
              "else": {"use": "next"}
            }
          ],
          "spacing": 8,
          "modifiers": [{"animation": {"curve": "smooth", "value": "{{step}}"}}]
        }
      ],
      "alignment": "leading",
      "spacing": 8,
      "modifiers": [{"padding": {"horizontal": 16, "vertical": 13}}, {"foreground": "#3A2A1F"}]
    },
    "compactLeading": {
      "text": "{{step}}",
      "modifiers": [
        {"font": "subheadline"},
        {"fontWeight": "bold"},
        {"fontDesign": "serif"},
        {"foreground": "white"},
        {"contentTransition": {"numericText": "{{step}}"}},
        {"frame": {"width": 22, "height": 22}},
        {"background": "#C8432B"},
        {"clip": "circle"},
        {"padding": {"leading": 2}}
      ]
    },
    "compactTrailing": {
      "if": "{{timer.on}}",
      "then": {
        "date": "{{timer.end}}",
        "style": "timer",
        "modifiers": [
          {"monospacedDigit": true},
          {"foreground": "#FF7A5C"},
          {"multilineTextAlignment": "trailing"},
          {"frame": {"width": 44}}
        ]
      },
      "else": {"text": "of {{of}}", "modifiers": [{"fontDesign": "serif"}, {"foreground": "#FF7A5C"}]}
    },
    "minimal": {
      "if": "{{timer.on}}",
      "then": {
        "progress": ["{{timer.start}}", "{{timer.end}}"],
        "style": "circular",
        "countsDown": true,
        "modifiers": [{"tint": "#FF7A5C"}, {"frame": {"width": 24, "height": 24}}]
      },
      "else": {"text": "{{step}}", "modifiers": [{"fontWeight": "bold"}, {"fontDesign": "serif"}, {"foreground": "#FF7A5C"}]}
    },
    "expanded": {
      "leading": {
        "text": "{{step}}",
        "modifiers": [
          {"font": 34},
          {"fontWeight": "bold"},
          {"fontDesign": "serif"},
          {"foreground": "#FF7A5C"},
          {"contentTransition": {"numericText": "{{step}}"}},
          {"padding": {"leading": 8}}
        ]
      },
      "center": {
        "concat": [{"text": "{{dish}}", "modifiers": [{"fontWeight": "semibold"}]}, " · step {{step}} of {{of}}"],
        "modifiers": [{"font": "subheadline"}, {"fontDesign": "serif"}]
      },
      "trailing": {
        "if": "{{timer.on}}",
        "then": {
          "zstack": [
            {
              "progress": ["{{timer.start}}", "{{timer.end}}"],
              "style": "circular",
              "countsDown": true,
              "modifiers": [{"tint": "#FF7A5C"}]
            },
            {
              "date": "{{timer.end}}",
              "style": "timer",
              "modifiers": [
                {"font": 9},
                {"bold": true},
                {"monospacedDigit": true},
                {"multilineTextAlignment": "center"},
                {"frame": {"width": 30}}
              ]
            }
          ],
          "modifiers": [{"frame": {"width": 38, "height": 38}}]
        },
        "modifiers": [{"padding": {"trailing": 4}}]
      },
      "bottom": {
        "vstack": [
          {
            "text": "{{steps[step].text}}",
            "modifiers": [
              {"font": "callout"},
              {"fontDesign": "serif"},
              {"lineLimit": 2},
              {"fixedSize": "vertical"},
              {"frame": {"maxWidth": "infinity", "alignment": "leading"}},
              {"transition": [{"push": "trailing"}, "opacity"]},
              {"id": "{{step}}"}
            ]
          },
          {
            "hstack": [
              {
                "if": "{{steps[step].first}}",
                "then": {
                  "concat": [{"symbol": "flame.fill"}, " Let's cook"],
                  "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"fontDesign": "serif"}, {"foreground": "#C9B2A6"}]
                },
                "else": {
                  "button": "back",
                  "label": {"concat": [{"symbol": "chevron.left"}, " Back"], "modifiers": [{"font": "subheadline"}]},
                  "style": "bordered",
                  "add": {"step": -1},
                  "modifiers": [{"tint": "#C9B2A6"}]
                }
              },
              {"spacer": true},
              {
                "if": "{{timer.on}}",
                "then": {
                  "button": "stop-timer",
                  "label": {"use": "stop"},
                  "style": "bordered",
                  "set": {"timer.on": false},
                  "modifiers": [{"tint": "#FF7A5C"}]
                },
                "else": {
                  "if": "{{steps[step].timed}}",
                  "then": {
                    "button": "start-timer",
                    "label": {"use": "start"},
                    "style": "bordered",
                    "set": {"timer.on": true},
                    "now": {"timer.start": 0, "timer.end": "{{steps[step].seconds}}"},
                    "modifiers": [{"tint": "#FF7A5C"}]
                  }
                }
              },
              {
                "if": "{{steps[step].last}}",
                "then": {
                  "concat": [{"symbol": "fork.knife"}, " Enjoy"],
                  "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"fontDesign": "serif"}, {"foreground": "#FF7A5C"}]
                },
                "else": {"use": "next"}
              }
            ],
            "spacing": 8
          }
        ],
        "spacing": 8,
        "modifiers": [{"animation": {"curve": "smooth", "value": "{{step}}"}}]
      }
    },
    "background": "#FBF3E4",
    "keyline": "#C8432B"
  },
  "data": {
    "dish": "Shakshuka",
    "serves": 4,
    "step": 4,
    "of": 8,
    "steps": {
      "1": {"text": "Warm the oil and soften the onion and pepper for 8 minutes", "first": true, "last": false, "timed": true, "seconds": 480},
      "2": {"text": "Stir in the garlic, cumin and paprika for a minute", "first": false, "last": false, "timed": true, "seconds": 60},
      "3": {"text": "Add the tomatoes and simmer for 10 minutes until thick", "first": false, "last": false, "timed": true, "seconds": 600},
      "4": {"text": "Crack the eggs into the wells, then cover the pan for 6 minutes", "first": false, "last": false, "timed": true, "seconds": 360},
      "5": {"text": "Crumble the feta between the eggs", "first": false, "last": false, "timed": false, "seconds": 0},
      "6": {"text": "Warm the bread in the oven for 4 minutes", "first": false, "last": false, "timed": true, "seconds": 240},
      "7": {"text": "Scatter over coriander and chilli flakes", "first": false, "last": false, "timed": false, "seconds": 0},
      "8": {"text": "Bring the pan to the table and serve", "first": false, "last": true, "timed": false, "seconds": 0}
    },
    "timer": {"on": true, "start": 1792999910, "end": 1793000270}
  },
  "endAfter": 7200
}
