{
  "title": "Cooking shakshuka",
  "layout": {
    "lockScreen": {
      "vstack": [
        {
          "hstack": [
            {
              "text": "{{dish}}",
              "modifiers": [
                {"font": "caption"},
                {"fontWeight": "bold"},
                {"textCase": "uppercase"},
                {"tracking": 1.5},
                {"foreground": "#C8432B"}
              ]
            },
            {"text": "serves {{serves}}", "modifiers": [{"font": "caption"}, {"italic": true}, {"foreground": "#8A7462"}]},
            {"spacer": true},
            {
              "hstack": [
                {
                  "each": "pages",
                  "as": "page",
                  "do": {
                    "shape": "capsule",
                    "fill": "{{page.color}}",
                    "modifiers": [{"frame": {"width": "{{page.width}}", "height": 6}}]
                  }
                }
              ],
              "spacing": 4,
              "modifiers": [{"animation": {"curve": "snappy", "value": "{{n}}"}}]
            }
          ],
          "spacing": 6,
          "modifiers": [{"fontDesign": "serif"}]
        },
        {
          "hstack": [
            {
              "text": "{{n}}",
              "modifiers": [
                {"font": 50},
                {"fontWeight": "bold"},
                {"fontDesign": "serif"},
                {"foreground": "#C8432B"},
                {"transition": [{"push": "trailing"}, "opacity"]},
                {"id": "{{n}}"},
                {"frame": {"width": 34, "alignment": "leading"}}
              ]
            },
            {
              "text": "{{text}}",
              "modifiers": [
                {"font": "title3"},
                {"fontWeight": "medium"},
                {"fontDesign": "serif"},
                {"lineLimit": 3},
                {"minimumScaleFactor": 0.8},
                {"frame": {"maxWidth": "infinity", "alignment": "leading"}},
                {"transition": [{"push": "trailing"}, "opacity"]},
                {"id": "{{n}}"}
              ]
            },
            {
              "if": "{{timer.on}}",
              "then": {
                "zstack": [
                  {
                    "progress": ["{{timer.start}}", "{{timer.end}}"],
                    "style": "circular",
                    "countsDown": true,
                    "modifiers": [{"tint": "#C8432B"}]
                  },
                  {
                    "date": "{{timer.end}}",
                    "style": "timer",
                    "modifiers": [
                      {"font": 11},
                      {"bold": true},
                      {"monospacedDigit": true},
                      {"multilineTextAlignment": "center"},
                      {"frame": {"width": 38}}
                    ]
                  }
                ],
                "modifiers": [{"frame": {"width": 50, "height": 50}}]
              }
            }
          ],
          "alignment": "center",
          "spacing": 10,
          "modifiers": [{"animation": {"curve": "smooth", "value": "{{n}}"}}]
        },
        {
          "hstack": [
            {
              "button": "back",
              "label": {"concat": [{"symbol": "chevron.left"}, " Back"], "modifiers": [{"font": "subheadline"}]},
              "style": "bordered",
              "modifiers": [{"tint": "#8A7462"}]
            },
            {"spacer": true},
            {
              "button": "next",
              "label": {
                "concat": ["Next step ", {"symbol": "chevron.right"}],
                "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"foreground": "white"}]
              },
              "style": "borderedProminent",
              "modifiers": [{"tint": "#C8432B"}]
            }
          ]
        }
      ],
      "alignment": "leading",
      "spacing": 8,
      "modifiers": [{"padding": {"horizontal": 16, "vertical": 13}}, {"foreground": "#3A2A1F"}]
    },
    "compactLeading": {
      "text": "{{n}}",
      "modifiers": [
        {"font": "subheadline"},
        {"fontWeight": "bold"},
        {"fontDesign": "serif"},
        {"foreground": "white"},
        {"frame": {"width": 22, "height": 22}},
        {"background": "#C8432B"},
        {"clip": "circle"},
        {"padding": {"leading": 2}}
      ]
    },
    "compactTrailing": {
      "if": "{{timer.on}}",
      "then": {
        "date": "{{timer.end}}",
        "style": "timer",
        "modifiers": [
          {"monospacedDigit": true},
          {"foreground": "#FF7A5C"},
          {"multilineTextAlignment": "trailing"},
          {"frame": {"width": 44}}
        ]
      },
      "else": {"text": "of {{steps}}", "modifiers": [{"fontDesign": "serif"}, {"foreground": "#FF7A5C"}]}
    },
    "minimal": {
      "if": "{{timer.on}}",
      "then": {
        "progress": ["{{timer.start}}", "{{timer.end}}"],
        "style": "circular",
        "countsDown": true,
        "modifiers": [{"tint": "#FF7A5C"}, {"frame": {"width": 24, "height": 24}}]
      },
      "else": {"text": "{{n}}", "modifiers": [{"fontWeight": "bold"}, {"fontDesign": "serif"}, {"foreground": "#FF7A5C"}]}
    },
    "expanded": {
      "leading": {
        "text": "{{n}}",
        "modifiers": [
          {"font": 34},
          {"fontWeight": "bold"},
          {"fontDesign": "serif"},
          {"foreground": "#FF7A5C"},
          {"transition": [{"push": "trailing"}, "opacity"]},
          {"id": "{{n}}"},
          {"padding": {"leading": 8}}
        ]
      },
      "center": {
        "concat": [{"text": "{{dish}}", "modifiers": [{"fontWeight": "semibold"}]}, " · step {{n}} of {{steps}}"],
        "modifiers": [{"font": "subheadline"}, {"fontDesign": "serif"}]
      },
      "trailing": {
        "if": "{{timer.on}}",
        "then": {
          "zstack": [
            {
              "progress": ["{{timer.start}}", "{{timer.end}}"],
              "style": "circular",
              "countsDown": true,
              "modifiers": [{"tint": "#C8432B"}]
            },
            {
              "date": "{{timer.end}}",
              "style": "timer",
              "modifiers": [
                {"font": 9},
                {"bold": true},
                {"monospacedDigit": true},
                {"multilineTextAlignment": "center"},
                {"frame": {"width": 30}}
              ]
            }
          ],
          "modifiers": [{"frame": {"width": 38, "height": 38}}]
        },
        "modifiers": [{"padding": {"trailing": 4}}]
      },
      "bottom": {
        "vstack": [
          {
            "text": "{{text}}",
            "modifiers": [
              {"font": "callout"},
              {"fontDesign": "serif"},
              {"lineLimit": 2},
              {"fixedSize": "vertical"},
              {"frame": {"maxWidth": "infinity", "alignment": "leading"}},
              {"transition": [{"push": "trailing"}, "opacity"]},
              {"id": "{{n}}"}
            ]
          },
          {
            "hstack": [
              {
                "button": "back",
                "label": {"concat": [{"symbol": "chevron.left"}, " Back"], "modifiers": [{"font": "subheadline"}]},
                "style": "bordered",
                "modifiers": [{"tint": "#C9B2A6"}]
              },
              {"spacer": true},
              {
                "button": "next",
                "label": {
                  "concat": ["Next step ", {"symbol": "chevron.right"}],
                  "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"foreground": "white"}]
                },
                "style": "borderedProminent",
                "modifiers": [{"tint": "#C8432B"}]
              }
            ]
          }
        ],
        "spacing": 8,
        "modifiers": [{"animation": {"curve": "smooth", "value": "{{n}}"}}]
      }
    },
    "background": "#FBF3E4",
    "keyline": "#C8432B"
  },
  "data": {
    "dish": "Shakshuka",
    "serves": 4,
    "n": 4,
    "steps": 9,
    "text": "Crack the eggs into the wells, then cover the pan",
    "timer": {"on": true, "start": 1792999910, "end": 1793000270},
    "pages": [
      {"color": "#C8432B", "width": 6},
      {"color": "#C8432B", "width": 6},
      {"color": "#C8432B", "width": 6},
      {"color": "#C8432B", "width": 16},
      {"color": "#3A2A1F33", "width": 6},
      {"color": "#3A2A1F33", "width": 6},
      {"color": "#3A2A1F33", "width": 6},
      {"color": "#3A2A1F33", "width": 6},
      {"color": "#3A2A1F33", "width": 6}
    ]
  },
  "endAfter": 7200
}
