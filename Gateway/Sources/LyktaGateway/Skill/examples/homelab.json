      "vstack": [
        {
          "hstack": [
            {"symbol": "server.rack", "modifiers": [{"font": "subheadline"}, {"foreground": "#30D158"}]},
            {
              "text": "{{host}}",
              "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"fontDesign": "monospaced"}]
