                            {"monospacedDigit": true},
                            {"contentTransition": "numericText"},
                            {"foreground": "{{metric.color}}"}
                          ]
                        }
                      ]
                    },
                    {
                      "chart": [
                        {
                          "area": "{{metric.series}}",
                          "color": {"gradient": ["{{metric.fade}}", "#00000000"]},
                          "interpolation": "monotone"
                        },
                        {
                          "line": "{{metric.series}}",
                          "color": "{{metric.color}}",
                          "lineWidth": 1.5,
                          "interpolation": "monotone"
                        }
                      ],
                      "min": 0,
                      "max": 100,
                      "modifiers": [{"frame": {"height": 30}}]
                    }
                  ],
                  "alignment": "leading",
                  "spacing": 3,
                  "modifiers": [{"padding": {"horizontal": 8, "vertical": 7}}, {"background": "#161B22"}, {"clip": 10}]
                }
              }
            }
          ],
          "spacing": 8
        },
        {
          "concat": [
