{
  "title": "Shopping at ICA",
  "layout": {
    "lockScreen": {
      "vstack": [
        {
          "hstack": [
            {
              "zstack": [
                {"shape": "roundedRectangle", "cornerRadius": 5.5, "fill": "#E3000F"},
                {"symbol": "cart.fill", "modifiers": [{"font": 11}, {"foreground": "white"}]}
              ],
              "modifiers": [{"frame": {"width": 22, "height": 22}}]
            },
            {"text": "{{store}} · our list", "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}]},
            {"spacer": true},
            {
              "concat": [{"symbol": "person.2.fill"}, " with {{with}}"],
              "modifiers": [{"font": "caption"}, {"foreground": "secondary"}]
            }
          ],
          "spacing": 8
        },
        {
          "hstack": [
            {
              "each": "aisles",
              "as": "aisle",
              "do": {
                "vstack": [
                  {
                    "concat": [{"symbol": "{{aisle.symbol}}"}, " {{aisle.name}}"],
                    "modifiers": [
                      {"font": "caption2"},
                      {"fontWeight": "semibold"},
                      {"textCase": "uppercase"},
                      {"foreground": "secondary"}
                    ]
                  },
                  {
                    "each": "aisle.items",
                    "as": "item",
                    "do": {
                      "toggle": "item.done",
                      "style": "checkbox",
                      "label": {
                        "if": "{{item.done}}",
                        "then": {"text": "{{item.name}}", "modifiers": [{"strikethrough": true}, {"foreground": "tertiary"}]},
                        "else": "{{item.name}}",
                        "modifiers": [{"lineLimit": 1}]
                      },
                      "modifiers": [{"tint": "#E3000F"}]
                    }
                  }
                ],
                "alignment": "leading",
                "spacing": 3,
                "modifiers": [{"frame": {"maxWidth": "infinity", "alignment": "leading"}}]
              }
            }
          ],
          "alignment": "top",
          "spacing": 12,
          "modifiers": [{"font": "footnote"}]
        }
      ],
      "alignment": "leading",
      "spacing": 10,
      "modifiers": [{"padding": {"horizontal": 16, "vertical": 14}}]
    },
    "compactLeading": {
      "zstack": [
        {"shape": "roundedRectangle", "cornerRadius": 5.0, "fill": "#E3000F"},
        {"symbol": "cart.fill", "modifiers": [{"font": 10}, {"foreground": "white"}]}
      ],
      "modifiers": [{"frame": {"width": 20, "height": 20}}, {"padding": {"leading": 2}}]
    },
    "compactTrailing": {"vstack": [{"each": "aisles", "as": "aisle", "do": {"hstack": [{"each": "aisle.items", "as": "item", "do": {"if": "{{item.done}}", "then": {"shape": "circle", "fill": "#FF4D58", "modifiers": [{"frame": {"width": 4.5, "height": 4.5}}]}, "else": {"shape": "circle", "fill": "#FF4D58", "modifiers": [{"opacity": 0.3}, {"frame": {"width": 4.5, "height": 4.5}}]}}}], "spacing": 2}}], "spacing": 2},
    "minimal": {"vstack": [{"each": "aisles", "as": "aisle", "do": {"hstack": [{"each": "aisle.items", "as": "item", "do": {"if": "{{item.done}}", "then": {"shape": "circle", "fill": "#FF4D58", "modifiers": [{"frame": {"width": 4.5, "height": 4.5}}]}, "else": {"shape": "circle", "fill": "#FF4D58", "modifiers": [{"opacity": 0.3}, {"frame": {"width": 4.5, "height": 4.5}}]}}}], "spacing": 2}}], "spacing": 2},
    "expanded": {
      "leading": {
        "zstack": [
          {"shape": "roundedRectangle", "cornerRadius": 6.5, "fill": "#E3000F"},
          {"symbol": "cart.fill", "modifiers": [{"font": 13}, {"foreground": "white"}]}
        ],
        "modifiers": [{"frame": {"width": 26, "height": 26}}, {"padding": {"leading": 6, "top": 4}}]
      },
      "center": {
        "text": "{{store}} · our list",
        "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"padding": {"top": 4}}]
      },
      "bottom": {
        "hstack": [
          {
            "each": "aisles",
            "as": "aisle",
            "do": {
              "vstack": [
                {
                  "concat": [{"symbol": "{{aisle.symbol}}"}, " {{aisle.name}}"],
                  "modifiers": [
                    {"font": "caption2"},
                    {"fontWeight": "semibold"},
                    {"textCase": "uppercase"},
                    {"foreground": "secondary"}
                  ]
                },
                {
                  "each": "aisle.items",
                  "as": "item",
                  "do": {
                    "toggle": "item.done",
                    "style": "checkbox",
                    "label": {
                      "if": "{{item.done}}",
                      "then": {"text": "{{item.name}}", "modifiers": [{"strikethrough": true}, {"foreground": "tertiary"}]},
                      "else": "{{item.name}}",
                      "modifiers": [{"lineLimit": 1}]
                    },
                    "modifiers": [{"tint": "#E3000F"}]
                  }
                }
              ],
              "alignment": "leading",
              "spacing": 3,
              "modifiers": [{"frame": {"maxWidth": "infinity", "alignment": "leading"}}]
            }
          }
        ],
        "alignment": "top",
        "spacing": 12,
        "modifiers": [{"font": "caption"}, {"padding": {"horizontal": 8}}]
      }
    },
    "keyline": "#E3000F"
  },
  "data": {
    "store": "ICA",
    "with": "Sam",
    "aisles": [
      {
        "name": "Fruit & veg",
        "symbol": "carrot.fill",
        "items": [
          {"name": "Bananas", "done": true},
          {"name": "Limes ×3", "done": false},
          {"name": "Coriander", "done": false},
          {"name": "Tomatoes", "done": true}
        ]
      },
      {
        "name": "Fridge",
        "symbol": "refrigerator.fill",
        "items": [
          {"name": "Oat milk", "done": true},
          {"name": "Halloumi", "done": false},
          {"name": "Yoghurt", "done": false},
          {"name": "Cheddar", "done": false}
        ]
      }
    ]
  },
  "endAfter": 7200
}
