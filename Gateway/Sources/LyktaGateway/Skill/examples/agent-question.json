{
  "title": "Codex needs a decision",
  "alert": {"title": "Codex needs you", "body": "Migration failed on staging. What now?", "sound": true},
  "layout": {
    "parts": {
      "choices": {
        "if": "{{answered}}",
        "then": {
          "hstack": [
            {"spacer": true},
            {"text": "{{agent}} is on it", "modifiers": [{"font": "caption"}, {"foreground": "#9C93B8"}]},
            {
              "concat": [{"symbol": "checkmark"}, " {{answer}}"],
              "modifiers": [
                {"font": "subheadline"},
                {"fontWeight": "semibold"},
                {"padding": {"horizontal": 12, "vertical": 7}},
                {"background": {"gradient": ["#8E6CFF", "#6E56CF"], "direction": "diagonal"}},
                {"clip": 16}
              ]
            }
          ],
          "spacing": 8,
          "modifiers": [{"transition": [{"move": "trailing"}, "opacity"]}]
        },
        "else": {
          "hstack": [
            {"spacer": true},
            {
              "each": "choices",
              "as": "choice",
              "do": {
                "button": "{{choice.id}}",
                "label": {"text": "{{choice.label}}", "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}]},
                "style": "{{choice.style}}",
                "set": {"answered": true, "answer": "{{choice.label}}"},
                "modifiers": [{"tint": "{{choice.tint}}"}]
              }
            }
          ],
          "spacing": 8,
          "modifiers": [{"transition": "opacity"}]
        }
      }
    },
    "lockScreen": {
      "vstack": [
        {
          "hstack": [
            {
              "zstack": [
                {"shape": "circle", "fill": {"gradient": ["#C9B2FF", "#6E56CF"], "direction": "diagonal"}},
                {"symbol": "sparkles", "modifiers": [{"font": 13}, {"foreground": "white"}]}
              ],
              "modifiers": [{"frame": {"width": 28, "height": 28}}]
            },
            {
              "vstack": [
                {
                  "hstack": [
                    {
                      "concat": [
                        {"text": "{{agent}}", "modifiers": [{"fontWeight": "semibold"}, {"foreground": "#B9A2FF"}]},
                        " in {{project}}"
                      ]
                    },
                    {"spacer": true},
                    {
                      "if": "{{answered}}",
                      "then": {"concat": [{"symbol": "checkmark.circle.fill"}, " answered"]},
                      "else": {
                        "concat": [
                          {"symbol": "hourglass"},
                          " ",
                          {"date": "{{asked}}", "style": "timer", "modifiers": [{"monospacedDigit": true}]}
                        ],
                        "modifiers": [{"frame": {"width": 64, "alignment": "trailing"}}]
                      }
                    }
                  ],
                  "modifiers": [{"font": "caption"}, {"foreground": "#9C93B8"}, {"padding": {"leading": 12}}]
                },
                {
                  "vstack": [
                    {
                      "text": "{{question}}",
                      "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}, {"lineLimit": 2}]
                    },
                    {
                      "text": "{{context}}",
                      "modifiers": [
                        {"font": "caption2"},
                        {"fontDesign": "monospaced"},
                        {"foreground": "#9C93B8"},
                        {"lineLimit": 1}
                      ]
                    }
                  ],
                  "alignment": "leading",
                  "spacing": 3,
                  "modifiers": [{"padding": {"horizontal": 12, "vertical": 9}}, {"background": "#272138"}, {"clip": 16}]
                }
              ],
              "alignment": "leading",
              "spacing": 4
            }
          ],
          "alignment": "bottom",
          "spacing": 8
        },
        {"use": "choices"}
      ],
      "spacing": 10,
      "modifiers": [
        {"padding": {"horizontal": 14, "vertical": 14}},
        {"foreground": "white"},
        {"animation": {"curve": "snappy", "value": "{{answered}}"}}
      ]
    },
    "compactLeading": {
      "zstack": [
        {"shape": "circle", "fill": {"gradient": ["#C9B2FF", "#6E56CF"], "direction": "diagonal"}},
        {"symbol": "sparkles", "modifiers": [{"font": 10}, {"foreground": "white"}]}
      ],
      "modifiers": [{"frame": {"width": 22, "height": 22}}, {"padding": {"leading": 2}}]
    },
    "compactTrailing": {
      "if": "{{answered}}",
      "then": {"symbol": "checkmark.circle.fill", "modifiers": [{"foreground": "#B9A2FF"}, {"padding": {"trailing": 2}}]},
      "else": {
        "date": "{{asked}}",
        "style": "timer",
        "modifiers": [
          {"monospacedDigit": true},
          {"multilineTextAlignment": "trailing"},
          {"foreground": "#B9A2FF"},
          {"frame": {"width": 44}}
        ]
      }
    },
    "minimal": {
      "if": "{{answered}}",
      "then": {"symbol": "checkmark.bubble.fill", "modifiers": [{"foreground": "#B9A2FF"}]},
      "else": {"symbol": "bubble.left.and.exclamationmark.bubble.right.fill", "modifiers": [{"foreground": "#B9A2FF"}]}
    },
    "expanded": {
      "leading": {
        "zstack": [
          {"shape": "circle", "fill": {"gradient": ["#C9B2FF", "#6E56CF"], "direction": "diagonal"}},
          {"symbol": "sparkles", "modifiers": [{"font": 15}, {"foreground": "white"}]}
        ],
        "modifiers": [{"frame": {"width": 32, "height": 32}}, {"padding": {"leading": 4, "top": 2}}]
      },
      "center": {
        "concat": [{"text": "{{agent}}", "modifiers": [{"foreground": "#B9A2FF"}]}, " in {{project}}"],
        "modifiers": [{"font": "subheadline"}, {"fontWeight": "semibold"}]
      },
      "trailing": {
        "if": "{{answered}}",
        "then": {"symbol": "checkmark.circle.fill", "modifiers": [{"font": "title3"}, {"foreground": "#B9A2FF"}]},
        "else": {
          "date": "{{asked}}",
          "style": "timer",
          "modifiers": [
            {"monospacedDigit": true},
            {"multilineTextAlignment": "trailing"},
            {"font": "caption"},
            {"foreground": "#9C93B8"},
            {"frame": {"width": 44, "alignment": "trailing"}}
          ]
        },
        "modifiers": [{"padding": {"trailing": 4, "top": 2}}]
      },
      "bottom": {
        "vstack": [
          {
            "text": "{{question}}",
            "modifiers": [{"font": "headline"}, {"lineLimit": 2}, {"frame": {"maxWidth": "infinity", "alignment": "leading"}}]
          },
          {"use": "choices"}
        ],
        "spacing": 8,
        "modifiers": [{"animation": {"curve": "snappy", "value": "{{answered}}"}}]
      }
    },
    "background": "#15121F",
    "keyline": "#B9A2FF"
  },
  "data": {
    "agent": "Codex",
    "project": "surface",
    "asked": 1792999740,
    "question": "Migration failed on staging. What now?",
    "context": "step 4/4 add_index · lock timeout",
    "answered": false,
    "answer": "",
    "choices": [
      {"id": "retry", "label": "Retry", "style": "bordered", "tint": "#C9B2FF"},
      {"id": "rollback", "label": "Roll back", "style": "borderedProminent", "tint": "#7C5CF0"},
      {"id": "stop", "label": "Stop", "style": "bordered", "tint": "#FF6B6B"}
    ]
  },
  "staleAfter": 3600,
  "endAfter": 7200
}
