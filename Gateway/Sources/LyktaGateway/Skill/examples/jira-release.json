{
  "title": "Release 4.2",
  "layout": {
    "lockScreen": {
      "vstack": [
        {
          "hstack": [
            {
              "zstack": [
                {"shape": "roundedRectangle", "cornerRadius": 5, "fill": "#1868DB"},
