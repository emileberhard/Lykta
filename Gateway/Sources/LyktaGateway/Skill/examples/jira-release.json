                        "spacing": 5
                      }
                    ],
                    [
                      {
                        "hstack": [
                          {"shape": "circle", "fill": "#1D7AFC", "modifiers": [{"frame": {"width": 7, "height": 7}}]},
                          {
                            "concat": [{"text": "{{doing}}", "modifiers": [{"bold": true}]}, " in progress"],
                            "modifiers": [{"font": "caption"}, {"monospacedDigit": true}]
                          }
