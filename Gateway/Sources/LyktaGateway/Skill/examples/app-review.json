{
  "title": "Lykta 1.0 in App Review",
  "layout": {
    "lockScreen": {
      "vstack": [
        {
          "hstack": [
            {
              "zstack": [
                {"shape": "roundedRectangle", "cornerRadius": 10.6, "fill": "white"},
                {
                  "symbol": "{{symbol}}",
                  "modifiers": [{"font": 21}, {"foreground": {"gradient": ["#1EA7FF", "#0753E6"], "direction": "diagonal"}}]
                }
              ],
              "modifiers": [{"frame": {"width": 44, "height": 44}}, {"shadow": {"color": "#00000033", "radius": 6, "y": 2}}]
            },
            {
              "vstack": [
                {"text": "{{app}} {{version}} for {{platform}}", "modifiers": [{"font": "caption"}, {"opacity": 0.85}]},
                {
                  "concat": [{"symbol": "{{stateSymbol}}"}, " {{state}}"],
                  "modifiers": [{"font": "title2"}, {"fontWeight": "bold"}, {"contentTransition": "interpolate"}]
                }
              ],
              "alignment": "leading",
              "spacing": 0
            },
            {"spacer": true},
            {
              "vstack": [
                {"text": "for", "modifiers": [{"font": "caption"}, {"opacity": 0.85}]},
                {
                  "date": "{{since}}",
                  "style": "timer",
                  "modifiers": [
                    {"font": "headline"},
                    {"fontWeight": "semibold"},
                    {"monospacedDigit": true},
                    {"multilineTextAlignment": "trailing"},
                    {"frame": {"width": 76, "alignment": "trailing"}}
                  ]
                }
              ],
              "alignment": "trailing",
              "spacing": 0
            }
          ],
          "spacing": 12
        },
        {
          "hstack": [
            {
              "each": "stages",
              "as": "stage",
              "do": {
                "vstack": [
                  {
                    "hstack": [
                      {"shape": "rectangle", "fill": "{{stage.in}}", "modifiers": [{"frame": {"height": 2}}]},
                      {
                        "symbol": "{{stage.symbol}}",
                        "modifiers": [{"font": 15}, {"foreground": "{{stage.color}}"}, {"contentTransition": "symbolReplace"}]
                      },
                      {"shape": "rectangle", "fill": "{{stage.out}}", "modifiers": [{"frame": {"height": 2}}]}
                    ],
                    "spacing": 3
                  },
                  {
                    "text": "{{stage.name}}",
                    "modifiers": [
                      {"font": 10},
                      {"fontWeight": "{{stage.weight}}"},
                      {"foreground": "{{stage.color}}"},
                      {"lineLimit": 1}
                    ]
                  }
                ],
                "spacing": 4,
                "modifiers": [{"frame": {"maxWidth": "infinity"}}]
              }
            }
          ],
          "spacing": 0
        }
      ],
      "spacing": 14,
      "modifiers": [{"padding": 16}, {"foreground": "white"}, {"background": {"gradient": "{{tint}}", "direction": "diagonal"}}]
    },
    "compactLeading": {
      "zstack": [
        {"shape": "roundedRectangle", "cornerRadius": 5.3, "fill": {"gradient": ["#1EA7FF", "#0753E6"], "direction": "diagonal"}},
        {"symbol": "{{symbol}}", "modifiers": [{"font": 11}, {"foreground": "white"}]}
      ],
      "modifiers": [{"frame": {"width": 22, "height": 22}}, {"padding": {"leading": 2}}]
    },
    "compactTrailing": {
      "text": "{{shortState}}",
      "modifiers": [{"font": "caption"}, {"bold": true}, {"foreground": "{{stateColor}}"}]
    },
    "minimal": {
      "symbol": "{{stateSymbol}}",
      "modifiers": [{"foreground": "{{stateColor}}"}, {"contentTransition": "symbolReplace"}]
    },
    "expanded": {
      "leading": {
        "zstack": [
          {
            "shape": "roundedRectangle",
            "cornerRadius": 9.6,
            "fill": {"gradient": ["#1EA7FF", "#0753E6"], "direction": "diagonal"}
          },
          {"symbol": "{{symbol}}", "modifiers": [{"font": 19}, {"foreground": "white"}]}
        ],
        "modifiers": [{"frame": {"width": 40, "height": 40}}, {"padding": {"leading": 4, "top": 2}}]
      },
      "center": {
        "vstack": [
          {"text": "{{app}} {{version}}", "modifiers": [{"font": "caption"}, {"foreground": "secondary"}]},
          {"text": "{{state}}", "modifiers": [{"font": "headline"}, {"foreground": "{{stateColor}}"}]}
        ],
        "spacing": 0
      },
      "trailing": {
        "date": "{{since}}",
        "style": "timer",
        "modifiers": [
          {"font": "subheadline"},
          {"fontWeight": "semibold"},
          {"monospacedDigit": true},
          {"multilineTextAlignment": "trailing"},
          {"frame": {"width": 64, "alignment": "trailing"}},
          {"padding": {"trailing": 4, "top": 8}}
        ]
      },
      "bottom": {
        "hstack": [
          {
            "each": "stages",
            "as": "stage",
            "do": {
              "vstack": [
                {
                  "hstack": [
                    {"shape": "rectangle", "fill": "{{stage.in}}", "modifiers": [{"frame": {"height": 2}}]},
                    {
                      "symbol": "{{stage.symbol}}",
                      "modifiers": [{"font": 15}, {"foreground": "{{stage.color}}"}, {"contentTransition": "symbolReplace"}]
                    },
                    {"shape": "rectangle", "fill": "{{stage.out}}", "modifiers": [{"frame": {"height": 2}}]}
                  ],
                  "spacing": 3
                },
                {
                  "text": "{{stage.name}}",
                  "modifiers": [
                    {"font": 10},
                    {"fontWeight": "{{stage.weight}}"},
                    {"foreground": "{{stage.color}}"},
                    {"lineLimit": 1}
                  ]
                }
              ],
              "spacing": 4,
              "modifiers": [{"frame": {"maxWidth": "infinity"}}]
            }
          }
        ],
        "spacing": 0,
        "modifiers": [{"padding": {"top": 10}}]
      }
    },
    "background": "#0A6CF5",
    "keyline": "{{stateColor}}",
    "link": "https://appstoreconnect.apple.com/apps"
  },
  "data": {
    "app": "Lykta",
    "version": "1.0",
    "platform": "iOS",
    "symbol": "lightbulb.max.fill",
    "state": "In Review",
    "shortState": "Review",
    "stateSymbol": "eye.fill",
    "stateColor": "#5AB8FF",
    "tint": ["#1EA7FF", "#0753E6"],
    "since": 1792995600,
    "stages": [
      {
        "name": "Uploaded",
        "symbol": "checkmark.circle.fill",
        "color": "#FFFFFF",
        "weight": "regular",
        "in": "#FFFFFF00",
        "out": "#FFFFFF"
      },
      {
        "name": "Processed",
        "symbol": "checkmark.circle.fill",
        "color": "#FFFFFF",
        "weight": "regular",
        "in": "#FFFFFF",
        "out": "#FFFFFF"
      },
      {
        "name": "Waiting",
        "symbol": "checkmark.circle.fill",
        "color": "#FFFFFF",
        "weight": "regular",
        "in": "#FFFFFF",
        "out": "#FFFFFF"
      },
      {
        "name": "In Review",
        "symbol": "smallcircle.filled.circle.fill",
        "color": "#FFFFFF",
        "weight": "bold",
        "in": "#FFFFFF",
        "out": "#FFFFFF59"
      },
      {"name": "Ready", "symbol": "circle", "color": "#FFFFFF8C", "weight": "regular", "in": "#FFFFFF59", "out": "#FFFFFF00"}
    ]
  },
  "staleAfter": 3600,
  "endAfter": 28800
}
