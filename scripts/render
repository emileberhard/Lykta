ENGINE_INPUTS = ["Core/Package.swift", "Core/Sources", "iOS/Config", "iOS/Lykta.xcodeproj", "iOS/Previews", "iOS/Render", "iOS/Rendering"]
ENGINE_IDLE = 600
ENGINE_DEADLINE = 300
ENGINE_START = 30
ENGINE_STALL = 60
ENGINE_RESULT_LIFETIME = 600
ENGINE_LOG_LIMIT = 1 << 20
KEPT_APPS = 2
SCRIPT = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
WORKER_SETTINGS = Path.home() / ".config" / "lykta" / "render-worker.env"
WORKER_UPDATE_CHECK = 600


class RenderError(Exception):
    pass


class Xcode:
    def __init__(self):
        self.process = subprocess.Popen(["xcrun", "mcpbridge"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True)
        self.lock = threading.Lock()
        self.pending = {}
        self.identifier = 0
        self.closed = False
        threading.Thread(target=self.read, daemon=True).start()
        self.request("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                    "clientInfo": {"name": "lykta-render", "version": "1"}})
        self.send({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def send(self, message):
        with self.lock:
            self.process.stdin.write(json.dumps(message) + "\n")
            self.process.stdin.flush()

    def read(self):
        try:
            for line in self.process.stdout:
                message = json.loads(line)
                if "id" in message and message["id"] in self.pending:
                    self.pending[message["id"]].append(message)
                    self.pending[message["id"]][0].set()
        finally:
            with self.lock:
                self.closed = True
                waiters = list(self.pending.values())
            for waiter in waiters:
                waiter[0].set()

    def request(self, method, params):
        with self.lock:
            if self.closed:
                raise RenderError("xcrun mcpbridge exited; is Xcode 27 running with its MCP server enabled?")
            self.identifier += 1
            identifier = self.identifier
            self.pending[identifier] = [threading.Event()]
        self.send({"jsonrpc": "2.0", "id": identifier, "method": method, "params": params})
        answered = self.pending[identifier][0].wait(DEADLINE)
        waiter = self.pending.pop(identifier)
        if not answered:
            raise RenderError(f"Xcode did not answer {method} within {DEADLINE} seconds")
        if len(waiter) == 1:
            raise RenderError("xcrun mcpbridge exited; is Xcode 27 running with its MCP server enabled?")
        if "error" in waiter[1]:
            raise RenderError(waiter[1]["error"].get("message", str(waiter[1]["error"])))
        return waiter[1]["result"]

    def call(self, tool, arguments):
        result = self.request("tools/call", {"name": tool, "arguments": arguments})
        content = result.get("structuredContent")
        if content is None:
            text = result["content"][0]["text"]
            try:
                content = json.loads(text)
            except json.JSONDecodeError:
                content = {"message": text}
        if result.get("isError") or content.get("type") == "error":
            raise RenderError(str(content.get("data") or content.get("message") or content))
        return content

    def close(self):
        self.process.terminate()


def load(arguments):
    bodies = []
    for argument in arguments:
        if argument == "-":
            sources = [("stdin", sys.stdin.read(), Path.cwd())]
        elif argument.lstrip().startswith("{"):
            sources = [("inline", argument, Path.cwd())]
        elif Path(argument).is_dir():
            sources = [(path.stem, path.read_text(), path.parent) for path in sorted(Path(argument).glob("*.json"))]
        elif Path(argument).is_file():
            sources = [(Path(argument).stem, Path(argument).read_text(), Path(argument).parent)]
        else:
            raise RenderError(f"{argument}: not a file, directory, inline JSON or -")
        for name, text, folder in sources:
            try:
                body = json.loads(text)
            except json.JSONDecodeError as error:
                raise RenderError(f"{name}: invalid JSON: {error}")
            taken = {existing for existing, _, _ in bodies}
            unique = name if name not in taken else next(f"{name}-{n}" for n in range(2, 1000) if f"{name}-{n}" not in taken)
            if isinstance(body, dict) and "sender" in body and "body" in body:
                bodies.append((unique, "notification", notification(body, folder, name)))
                continue
            if not isinstance(body, dict) or not ("layout" in body or "lockScreen" in body or FAMILIES & body.keys()):
                raise RenderError(f"{name}: expected a layout, an object with a layout or a notification")
            if "layout" not in body:
                body = {"layout": body}
            kind = "widget" if isinstance(body["layout"], dict) and FAMILIES & body["layout"].keys() else "activity"
            bodies.append((unique, kind, {"title": body.get("title", unique), "layout": body["layout"], "data": body.get("data", {})}))
    if not bodies:
        raise RenderError("no inputs to render")
    return bodies


def notification(body, folder, name):
    def medium(file):
        try:
            return base64.b64encode((folder / file).read_bytes()).decode()
        except OSError as error:
            raise RenderError(f"{name}: name a media file beside it: {error}")
    sender = body["sender"]
    entry = {"sender": {"id": sender["id"], "name": sender["name"]}, "body": body["body"]}
    if isinstance(sender.get("avatar"), dict):
        entry["avatar"] = {"drawing": sender["avatar"]}
    elif isinstance(sender.get("avatar"), str):
        entry["avatar"] = {"image": medium(sender["avatar"])}
    if isinstance(body.get("image"), str):
        entry["image"] = medium(body["image"])
    return entry


def workspace(xcode):
    listing = xcode.call("XcodeListWorkspaces", {})["message"]
    match = re.search(r"workspaceIdentifier: (\S+), workspacePath: " + re.escape(str(PROJECT)) + r"$", listing, re.MULTILINE)
    identifier = match.group(1) if match else xcode.call("XcodeOpenWorkspace", {"path": str(PROJECT)})["workspaceIdentifier"]
    destinations = xcode.call("XcodeListRunDestinations", {"workspaceIdentifier": identifier})
    active = next((d for d in destinations["destinations"] if d["isActive"]), None)
    if not (active and active["isSimulator"] and "iPhone" in active["displayTitle"]):
        iphone = next((d for d in destinations["destinations"] if d["isSimulator"] and "iPhone" in d["displayTitle"]), None)
        if iphone is None:
            raise RenderError("no iPhone simulator is available as a run destination")
        xcode.call("XcodeSwitchRunDestination", {"workspaceIdentifier": identifier, "displayTitle": iphone["displayTitle"]})
    return identifier


def shows(presentation, kind, layout):
    family = PRESENTATIONS[presentation][0]
    return kind == "widget" and family in layout if family else kind == "activity"


def render(xcode, identifier, index, presentation, dark, target):
    family, preview, variants = PRESENTATIONS[presentation]
    lock_screen = family is not None and family.startswith("accessory")
    arguments = {
        "sourceFilePath": PREVIEW,
        "workspaceIdentifier": identifier,
        "previewDefinitionIndexInFile": preview,
        "previewVariantOverrides": variants | {"Color Scheme": "Dark Appearance" if dark else "Light Appearance"},
        "previewCanvasControlOverrides": {"timelineIndex": index},
        "timeout": 300,
    }
    if lock_screen:
        arguments |= {"displayMode": "interactive", "snapshotDelay": 2}
    launches = 0
    for _ in range(90):
        try:
            result = xcode.call("RenderPreview", arguments)
        except RenderError as error:
            if "PreviewBlockedReason" in str(error):
                time.sleep(2)
                continue
            if "AppLaunchTimeoutError" in str(error) and launches < 2:
                launches += 1
                continue
            raise
        shutil.move(result["snapshot"]["path"], target)
        if lock_screen:
            crop_to_clock(target)
        return
    raise RenderError("Xcode kept blocking previews; open the project in Xcode and check its package resolution")


def crop_to_clock(image):
    sizes = subprocess.run(["sips", "-g", "pixelHeight", "-g", "pixelWidth", str(image)], capture_output=True, text=True, check=True).stdout
    height, width = (int(re.search(rf"{key}: (\d+)", sizes).group(1)) for key in ("pixelHeight", "pixelWidth"))
    subprocess.run(["sips", "--cropToHeightWidth", str(height * 2 // 5), str(width), "--cropOffset", "1", "0", str(image)],
                   check=True, stdout=subprocess.DEVNULL)


def summary(message):
    errors = {}
    for line in message.splitlines():
        if "error:" in line:
            errors.setdefault(line.split("error:", 1)[1].strip(), line.strip(" |`-"))
    return "\n".join(errors.values()) if errors else message[:2000]


def xcode_renders(bodies, presentations, dark, output):
    if any(kind == "notification" for _, kind, _ in bodies):
        raise RenderError("notifications render only through the engine; leave out --xcode")
    presentations = [p for p in presentations if p not in NOTIFICATION_PRESENTATIONS]
    staged = []
    for name, kind, body in bodies:
        index = sum(1 for _, other in staged if other == kind)
        staged.append((index, kind))
        (STAGE / f"{kind}-{index:03d}-{name}.json").write_text(json.dumps(body))
    xcode = Xcode()
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=8)
    try:
        identifier = workspace(xcode)
        jobs = {(name, index, presentation): output / f"{name}-{presentation}.png"
                for presentation in presentations
                for (name, kind, body), (index, _) in zip(bodies, staged) if shows(presentation, kind, body["layout"])}
        failures = {}
        futures = {pool.submit(render, xcode, identifier, index, presentation, dark, target): target
                   for (_, index, presentation), target in jobs.items()}
        for future in concurrent.futures.as_completed(futures):
            if future.exception():
                failures.setdefault(summary(str(future.exception())), []).append(futures[future].stem)
    finally:
        xcode.close()
        pool.shutdown(cancel_futures=True)
    reports = [(name, STAGE / f"{kind}-{index:03d}-{name}.error") for (name, kind, _), (index, _) in zip(bodies, staged)]
    errors = [{"input": name, "error": report.read_text()} for name, report in reports if report.exists()]
    rendered = [(name, target) for (name, _, _), target in jobs.items() if target.exists()]
    return rendered, errors, [{"error": error, "renders": sorted(names)} for error, names in failures.items()], []


def engine_renders(bodies, presentations, dark, output):
    xcode_only = [p for p in presentations if p not in ENGINE_PRESENTATIONS]
    if xcode_only:
        raise RenderError(f"{', '.join(xcode_only)} render only through Xcode's previews; add --xcode")
    key = engine_app()
    jobs = JOBS / key
    jobs.mkdir(parents=True, exist_ok=True)
    start_supervisor()
    name = f"{time.time_ns()}-{os.getpid()}"
    request = jobs / f"{name}.request"
    body = {"inputs": [{"name": name_, "kind": kind, **body} for name_, kind, body in bodies],
            "presentations": presentations, "appearance": "dark" if dark else "light"}
    (jobs / f".{name}.json").write_text(json.dumps(body))
    (jobs / f".{name}.json").rename(request)
    result = jobs / name
    deadline = time.monotonic() + ENGINE_DEADLINE
    checked = time.monotonic()
    try:
        while not result.exists():
            if time.monotonic() - checked > 0.5:
                checked = time.monotonic()
                if not supervisor_running():
                    if request.exists():
                        start_supervisor()
                    elif not result.exists():
                        raise RenderError(f"the render engine stopped before answering:\n{log_tail()}")
                if checked > deadline:
                    raise RenderError(f"the render engine did not answer within {ENGINE_DEADLINE} seconds:\n{log_tail()}")
            time.sleep(0.005)
    finally:
        request.unlink(missing_ok=True)
    try:
        manifest = json.loads((result / "manifest.json").read_text())
        if "error" in manifest:
            raise RenderError(manifest["error"])
        rendered = []
        for entry in manifest["renders"]:
            target = output / entry["file"]
            shutil.move(result / entry["file"], target)
            rendered.append((entry["input"], target))
    finally:
        shutil.rmtree(result, ignore_errors=True)
    failures = []
    if incomplete := [entry["file"] for entry in manifest["renders"] if not entry["complete"]]:
        failures.append({"error": "the snapshot is missing image data for some views", "renders": incomplete})
    if blank := [f"{entry['input']}-{entry['presentation']}" for entry in manifest["blank"]]:
        failures.append({"error": "these presentations draw nothing", "renders": blank})
    tall = [f"{entry['input']} {entry['presentation']}: the content is {entry['idealHeight']:.0f} points tall, and the system shows "
            f"{LOCK_SCREEN_HEIGHT} and cuts off the rest" for entry in manifest["renders"] if (entry.get("idealHeight") or 0) > LOCK_SCREEN_HEIGHT + 0.5]
    return rendered, manifest["layoutErrors"], failures, tall


def run(*args, timeout=120):
    try:
        result = subprocess.run([str(arg) for arg in args], text=True, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise RenderError(f"{' '.join(map(str, args[:3]))} did not finish within {timeout} seconds")
    if result.returncode != 0:
        raise RenderError(f"{' '.join(map(str, args[:3]))} failed:\n{summary(result.stdout + result.stderr)}")
    return result.stdout


@contextlib.contextmanager
def locked(path, blocking=True):
    with open(path, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        except BlockingIOError:
            yield False
            return
        yield True


def engine_key():
    files = run("git", "-C", ROOT, "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", *ENGINE_INPUTS).split("\0")
    digest = hashlib.sha256()
    digest.update(run("xcodebuild", "-version").encode() + b"\0")
    for name in sorted(filter(None, files)):
        path = ROOT / name
        if path.is_file():
            digest.update(name.encode() + b"\0" + hashlib.sha256(path.read_bytes()).digest())
    return digest.hexdigest()[:20]


def engine_app():
    key = engine_key()
    app = APPS / key
    if app.exists():
        os.utime(app)
        return key
    APPS.mkdir(parents=True, exist_ok=True)
    with locked(ROOT / ".local" / "render-build.lock"), locked(APPS / f".{key}.lock"):
        if app.exists():
            return key
        print("Building the renderer for this checkout", file=sys.stderr)
        run("xcodebuild", "-quiet", "-project", PROJECT, "-scheme", "LyktaRender", "-configuration", "Debug",
            "-destination", "platform=macOS,variant=Mac Catalyst", "-derivedDataPath", BUILD,
            "-disableAutomaticPackageResolution", "-onlyUsePackageVersionsFromResolvedFile", "-skipPackageUpdates",
            "LYKTA_GATEWAY_HOST=", "build", timeout=1800)
        with tempfile.TemporaryDirectory(prefix=".", dir=APPS) as staging:
            shutil.copytree(BUILD / "Build" / "Products" / "Debug-maccatalyst" / "LyktaRender.app", Path(staging) / key / "LyktaRender.app",
                            symlinks=True)
            (Path(staging) / key).rename(app)
    return key


def supervisor_running():
    with open(ENGINE / "supervisor.lock", "a") as probe:
        try:
            fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        return False


def start_supervisor():
    if supervisor_running():
        version = ENGINE / "supervisor.json"
        if version.exists() and json.loads(version.read_text())["script"] == SCRIPT:
            return
        stop()
    if run("launchctl", "managername").strip() != "Aqua":
        raise RenderError("the renderer opens a window, so start it from the Mac's login session, such as Terminal or an agent on the Mac, "
                          "not over SSH")
    spawned = subprocess.Popen([sys.executable, __file__, "--supervise"], start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time.monotonic() + 30
    while not supervisor_running():
        if spawned.poll() is not None and not supervisor_running():
            raise RenderError(f"the render engine exited at start:\n{log_tail()}")
        if time.monotonic() > deadline:
            raise RenderError("the render engine did not start within 30 seconds")
        time.sleep(0.05)


def log_tail():
    log = ENGINE / "supervisor.log"
    return "\n".join(log.read_text(errors="replace").splitlines()[-40:]) if log.exists() else "(no engine log)"


class Renderer:
    def __init__(self, key, log):
        self.key = key
        self.process = subprocess.Popen([str(APPS / key / "LyktaRender.app" / "Contents" / "MacOS" / "LyktaRender")],
                                        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log, start_new_session=True)
        self.started = time.monotonic()
        self.ready = False
        self.lines = queue.Queue()
        threading.Thread(target=self.read, daemon=True).start()

    def read(self):
        for line in self.process.stdout:
            self.lines.put(line)

    def send(self, line):
        threading.Thread(target=self.write, args=(line,), daemon=True).start()

    def write(self, line):
        try:
            self.process.stdin.write(line)
            self.process.stdin.flush()
        except (BrokenPipeError, ValueError):
            pass

    def stop(self):
        if self.process.poll() is None:
            self.process.kill()
        self.process.wait()


class Supervisor:
    def __init__(self, log):
        self.log = log
        self.renderer = None
        self.inflight = None

    def say(self, message):
        print(f"{time.strftime('%H:%M:%S')} {message}", file=self.log, flush=True)

    def serve(self):
        self.say(f"serving with {__file__}")
        idle = time.monotonic()
        try:
            while True:
                stopping = (ENGINE / "stop").exists()
                self.collect()
                self.check()
                pending = [] if stopping else self.pending()
                if pending or self.inflight:
                    idle = time.monotonic()
                elif stopping:
                    self.say("stopping")
                    break
                elif time.monotonic() - idle > ENGINE_IDLE:
                    self.say(f"idle for {ENGINE_IDLE} seconds")
                    break
                if pending and not self.inflight:
                    self.dispatch(pending[0])
                self.prune()
                self.trim()
        finally:
            if self.inflight:
                self.fail(self.inflight[0], "the render engine stopped while drawing this request")
            if self.renderer:
                self.renderer.stop()
            (ENGINE / "stop").unlink(missing_ok=True)

    def pending(self):
        expired = time.time() - ENGINE_DEADLINE
        requests = []
        for request in sorted(JOBS.glob("*/*.request"), key=lambda path: path.name):
            try:
                if request.stat().st_mtime < expired:
                    request.unlink()
                else:
                    requests.append(request)
            except FileNotFoundError:
                pass
        return requests

    def collect(self):
        if self.renderer is None:
            time.sleep(0.02)
            return
        try:
            line = self.renderer.lines.get(timeout=0.02)
        except queue.Empty:
            return
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            self.say(f"the renderer wrote {line[:200]!r}")
            return
        if message.get("ready"):
            self.renderer.ready = True
            self.say(f"the renderer for {self.renderer.key} is ready")
        elif self.inflight and message.get("id") == self.inflight[0].stem:
            self.complete(self.inflight[0], message)
            self.inflight = None

    def check(self):
        renderer = self.renderer
        if renderer is None:
            return
        if renderer.process.poll() is not None:
            self.say(f"the renderer for {renderer.key} exited with {renderer.process.returncode}")
            if self.inflight:
                self.fail(self.inflight[0], f"the renderer exited while drawing this request:\n{log_tail()}")
                self.inflight = None
            elif not renderer.ready:
                for request in (JOBS / renderer.key).glob("*.request"):
                    self.fail(request, f"the renderer exited at start:\n{log_tail()}")
            self.renderer = None
        elif not renderer.ready and time.monotonic() - renderer.started > ENGINE_START:
            self.say(f"the renderer for {renderer.key} did not start within {ENGINE_START} seconds")
            renderer.stop()
            self.renderer = None
            for request in (JOBS / renderer.key).glob("*.request"):
                self.fail(request, f"the renderer did not start within {ENGINE_START} seconds:\n{log_tail()}")
        elif self.inflight and time.monotonic() - self.inflight[1] > ENGINE_STALL:
            self.say(f"the renderer for {renderer.key} spent more than {ENGINE_STALL} seconds on one request")
            renderer.stop()
            self.renderer = None
            self.fail(self.inflight[0], f"the renderer spent more than {ENGINE_STALL} seconds on this request and was restarted")
            self.inflight = None

    def dispatch(self, request):
        key = request.parent.name
        if self.renderer is None or self.renderer.key != key:
            if self.renderer:
                self.renderer.stop()
                self.renderer = None
            if not (APPS / key).exists():
                self.fail(request, "the renderer for this checkout was removed from the cache; render again to rebuild it")
                return
            os.utime(APPS / key)
            self.say(f"starting the renderer for {key}")
            self.renderer = Renderer(key, self.log)
            self.evict()
            return
        if not self.renderer.ready:
            return
        working = request.with_suffix(".working")
        try:
            request.rename(working)
        except FileNotFoundError:
            return
        body = json.loads(working.read_text())
        self.renderer.send((json.dumps({"id": working.stem, **body}) + "\n").encode())
        self.inflight = (working, time.monotonic())

    def complete(self, working, message):
        result = working.with_suffix("")
        staging = working.parent / f".{result.name}"
        shutil.rmtree(staging, ignore_errors=True)
        staging.mkdir()
        renders = []
        for entry in message["renders"]:
            file = f"{entry['input']}-{entry['presentation']}.png"
            (staging / file).write_bytes(base64.b64decode(entry.pop("png")))
            renders.append({**entry, "file": file})
        (staging / "manifest.json").write_text(json.dumps({"renders": renders, "blank": message["blank"], "layoutErrors": message["layoutErrors"]}))
        staging.rename(result)
        working.unlink()

    def fail(self, request, error):
        result = request.with_suffix("")
        staging = request.parent / f".{result.name}"
        shutil.rmtree(staging, ignore_errors=True)
        staging.mkdir()
        (staging / "manifest.json").write_text(json.dumps({"error": error}))
        staging.rename(result)
        request.unlink(missing_ok=True)

    def evict(self):
        needed = {request.parent.name for request in JOBS.glob("*/*.request")} | {self.renderer.key}
        apps = sorted((path for path in APPS.iterdir() if path.is_dir() and not path.name.startswith(".")),
                      key=lambda path: path.stat().st_mtime, reverse=True)
        for app in apps[KEPT_APPS:]:
            if app.name in needed:
                continue
            with locked(APPS / f".{app.name}.lock", blocking=False) as acquired:
                if acquired:
                    shutil.rmtree(app, ignore_errors=True)
                    (APPS / f".{app.name}.lock").unlink(missing_ok=True)

    def prune(self):
        expired = time.time() - ENGINE_RESULT_LIFETIME
        for folder in list(JOBS.iterdir()):
            try:
                for entry in list(folder.iterdir()):
                    if entry != (self.inflight or (None,))[0] and entry.stat().st_mtime < expired:
                        shutil.rmtree(entry, ignore_errors=True) if entry.is_dir() else entry.unlink(missing_ok=True)
                if not (APPS / folder.name).exists() and not any(folder.iterdir()):
                    folder.rmdir()
            except (FileNotFoundError, OSError):
                pass

    def trim(self):
        if os.fstat(self.log.fileno()).st_size > ENGINE_LOG_LIMIT:
            self.log.truncate(0)
            self.say(f"cleared the log at {ENGINE_LOG_LIMIT} bytes")


def supervise():
    ENGINE.mkdir(parents=True, exist_ok=True)
    JOBS.mkdir(exist_ok=True)
    with open(ENGINE / "supervisor.lock", "a") as lock:
        for attempt in range(20):
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                time.sleep(0.05)
        else:
            return 0
        (ENGINE / "stop").unlink(missing_ok=True)
        (ENGINE / "supervisor.json").write_text(json.dumps({"script": SCRIPT}))
        with open(ENGINE / "supervisor.log", "a") as log:
            log.truncate(0)
            try:
                Supervisor(log).serve()
            except Exception as error:
                print(f"render engine failed: {error!r}", file=log, flush=True)
                return 1
    return 0


def stop():
    if not ENGINE.exists() or not supervisor_running():
        return 0
    (ENGINE / "stop").touch()
    deadline = time.monotonic() + ENGINE_STALL + 10
    while supervisor_running():
        if time.monotonic() > deadline:
            raise RenderError("the render engine did not stop in time")
        time.sleep(0.1)
    return 0


def sheet(rows, target):
    source = ROOT / "scripts" / "sheet.swift"
    binary = CACHE / f"sheet-{hashlib.sha256(source.read_bytes()).hexdigest()[:16]}"
    if not binary.exists():
        CACHE.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".sheet-", dir=CACHE) as staging:
            run("xcrun", "swiftc", "-O", source, "-o", Path(staging) / "sheet")
            (Path(staging) / "sheet").rename(binary)
        for stale in CACHE.glob("sheet-*"):
            if stale != binary:
                stale.unlink()
    arguments = [str(target)] + ["\t".join([label] + [str(path) for path in paths]) for label, paths in rows]
    run(binary, *arguments)


def worker():
    try:
        settings = dict(line.split("=", 1) for line in WORKER_SETTINGS.read_text().splitlines() if "=" in line and not line.startswith("#"))
        url, token = settings["LYKTA_URL"].rstrip("/"), settings["LYKTA_RENDER_TOKEN"]
    except (OSError, KeyError) as error:
        raise RenderError(f"set LYKTA_URL and LYKTA_RENDER_TOKEN in {WORKER_SETTINGS}: {error}")
    version = run("git", "-C", ROOT, "tag", "--points-at", "HEAD", "--list", "[0-9]*.[0-9]*.[0-9]*").split()
    print(f"rendering for {url} at {version[0] if version else 'an untagged commit'}", flush=True)
    engine_app()
    start_supervisor()
    checked = time.monotonic()
    failures = 0
    while True:
        if time.monotonic() - checked > WORKER_UPDATE_CHECK:
            checked = time.monotonic()
            try:
                served = call("GET", f"{url}/v1/version", token)["version"]
            except (urllib.error.URLError, OSError, TypeError, KeyError) as error:
                print(f"reading the gateway's version failed: {error}", flush=True)
            else:
                if served not in version:
                    print(f"the gateway runs {served}; exiting to follow it", flush=True)
                    return 0
        try:
            job = call("GET", f"{url}/v1/render/jobs?wait=25", token)
            failures = 0
        except (urllib.error.URLError, OSError) as error:
            failures += 1
            print(f"polling failed: {error}", flush=True)
            time.sleep(min(60, 2 ** min(failures, 6)))
            continue
        if job is None:
            continue
        if (ENGINE / "worker.log").exists() and (ENGINE / "worker.log").stat().st_size > ENGINE_LOG_LIMIT:
            os.truncate(ENGINE / "worker.log", 0)
        started = time.monotonic()
        result = draw(job)
        try:
            call("PUT", f"{url}/v1/render/jobs/{job['id']}", token, json.dumps(result).encode())
            print(f"answered {job['id']} in {time.monotonic() - started:.1f} s{': ' + result['error'] if 'error' in result else ''}", flush=True)
        except (urllib.error.URLError, OSError) as error:
            print(f"answering {job['id']} failed: {error}", flush=True)


def call(method, url, token, body=None):
    request = urllib.request.Request(url, data=body, method=method, headers={
        "Authorization": f"Bearer {token}", "Content-Type": "application/json", "User-Agent": "lykta-render-worker"})
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.loads(response.read()) if response.status == 200 else None


def draw(job):
    body = dict(job["input"])
    kind = body.pop("kind")
    try:
        with tempfile.TemporaryDirectory(prefix="lykta-render-") as folder:
            rows, warnings = [], []
            for dark in (False, True):
                output = Path(folder) / ("dark" if dark else "light")
                output.mkdir()
                rendered, errors, failures, tall = engine_renders([(job["name"], kind, body)], job["presentations"], dark, output)
                problems = [error["error"] for error in errors] + [f"{failure['error']}: {', '.join(failure['renders'])}" for failure in failures]
                if problems or not rendered:
                    return {"error": "; ".join(problems) or "nothing to draw"}
                rows.append(("Dark" if dark else "Light", [target for _, target in rendered]))
                warnings += [] if dark else tall
            image = Path(folder) / "sheet.png"
            sheet(rows, image)
            width = int(re.search(r"pixelWidth: (\d+)", run("sips", "-g", "pixelWidth", image)).group(1))
            run("sips", "--resampleWidth", str(width * 2 // 3), image)
            return {"image": base64.b64encode(image.read_bytes()).decode(), "warnings": warnings}
    except RenderError as error:
        return {"error": str(error)}


def main():
    parser = argparse.ArgumentParser(
        description="Render Lykta layouts and notifications in about a second through a resident Mac app, which stops "
                    f"after {ENGINE_IDLE // 60} idle minutes, or through Xcode's previews with --xcode.")
    parser.add_argument("inputs", nargs="*",
                        help="request bodies of activities, widgets or notifications, or bare layouts: files, directories, inline JSON, "
                             "or - for stdin; a notification's media ids name files beside it")
    parser.add_argument("--only", default=DEFAULT,
                        help=f"comma-separated presentations from {', '.join(KNOWN)}; each input renders those it has "
                             f"(default: {DEFAULT})")
    parser.add_argument("--dark", action="store_true", help="render in dark appearance")
    parser.add_argument("--xcode", action="store_true",
                        help="render through Xcode's previews, which draw the system's own Dynamic Island, Lock Screen and StandBy "
                             "and take seconds per image; needs Xcode 27 with its MCP server enabled")
    parser.add_argument("--stop", action="store_true", help="stop the render engine now")
    parser.add_argument("--worker", action="store_true",
                        help=f"render for a gateway: claim its render jobs with the URL and token in {WORKER_SETTINGS} until the gateway runs another release")
    parser.add_argument("--supervise", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    try:
        if args.supervise:
            return supervise()
        if args.stop:
            return stop()
        if args.worker:
            return worker()
        if not args.inputs:
            parser.error("give at least one input to render")
        presentations = args.only.split(",")
        unknown = [p for p in presentations if p not in KNOWN]
        if unknown:
            raise RenderError(f"unknown presentation {', '.join(unknown)}; use {', '.join(KNOWN)}")
        bodies = load(args.inputs)
        STAGE.mkdir(parents=True, exist_ok=True)
        with open(ROOT / ".local" / "render.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            for stale in list(STAGE.iterdir()) + (list(OUTPUT.iterdir()) if OUTPUT.exists() else []):
                stale.unlink()
            OUTPUT.mkdir(exist_ok=True)
            renders = xcode_renders if args.xcode else engine_renders
            rendered, errors, failures, tall = renders(bodies, presentations, args.dark, OUTPUT)
            rows = [(name, [target for owner, target in rendered if owner == name]) for name, _, _ in bodies]
            result = {"renders": [str(target) for _, target in rendered], "layoutErrors": errors, "renderFailures": failures, "tooTall": tall}
            if rendered:
                sheet([row for row in rows if row[1]], OUTPUT / "sheet.png")
                result["sheet"] = str(OUTPUT / "sheet.png")
        print(json.dumps(result, indent=2))
        return 1 if errors or failures else 0
    except RenderError as error:
        print(f"render: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
