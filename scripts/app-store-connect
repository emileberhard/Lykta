#!/usr/bin/env python3
import base64
import concurrent.futures
import json
import os
import queue
import random
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

API = "https://api.appstoreconnect.apple.com/v1/"
EDITABLE = {"PREPARE_FOR_SUBMISSION", "DEVELOPER_REJECTED", "REJECTED", "METADATA_REJECTED", "INVALID_BINARY"}
IN_REVIEW = {"WAITING_FOR_REVIEW", "IN_REVIEW"}
OPEN_SUBMISSIONS = "READY_FOR_REVIEW,WAITING_FOR_REVIEW,IN_REVIEW,UNRESOLVED_ISSUES,CANCELING"
RELEASED = {"READY_FOR_DISTRIBUTION", "PROCESSING_FOR_DISTRIBUTION", "REPLACED_WITH_NEW_VERSION"}
IN_BETA = {"WAITING_FOR_BETA_REVIEW", "IN_BETA_REVIEW", "BETA_APPROVED", "READY_FOR_BETA_TESTING", "IN_BETA_TESTING"}
SCREENSHOTS = {"placementType": "APP_SCREENSHOT", "placementGroup": "IPHONE_DYNAMIC_ISLAND_MEDIUM_PROFILE"}
DEADLINE = time.monotonic() + 40 * 60


class RequestFailed(Exception):
    pass


def token():
    now = int(time.time())
    encode = lambda value: base64.urlsafe_b64encode(json.dumps(value).encode()).rstrip(b"=")
    claims = {"iss": os.environ["APP_STORE_CONNECT_ISSUER_ID"], "iat": now, "exp": now + 600, "aud": "appstoreconnect-v1"}
    signed = encode({"alg": "ES256", "kid": os.environ["APP_STORE_CONNECT_KEY_ID"], "typ": "JWT"}) + b"." + encode(claims)
    der = subprocess.run(["openssl", "dgst", "-sha256", "-sign", os.environ["APP_STORE_CONNECT_KEY_PATH"]],
                         input=signed, capture_output=True, check=True).stdout
    r, s = der[4:4 + der[3]], der[6 + der[3]:]
    signature = r[-32:].rjust(32, b"\0") + s[-32:].rjust(32, b"\0")
    return (signed + b"." + base64.urlsafe_b64encode(signature).rstrip(b"=")).decode()


def send(request):
    refreshed = False
    for attempt in range(6):
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                return response.read()
        except urllib.error.HTTPError as error:
            if (error.code == 401 and request.get_method() == "GET" and not refreshed and attempt < 5
                    and request.full_url.startswith(API) and request.has_header("Authorization")):
                error.close()
                request.add_header("Authorization", f"Bearer {token()}")
                refreshed = True
                continue
            retryable = error.code == 429 or error.code >= 500 and request.get_method() != "POST"
            if not retryable or attempt == 5:
                raise RequestFailed(f"{request.get_method()} {request.full_url} failed with {error.code}: {error.read().decode(errors='replace')[:2000]}")
            delay = error.headers.get("Retry-After")
        except (urllib.error.URLError, TimeoutError) as error:
            if request.get_method() == "POST" or attempt == 5:
                raise RequestFailed(f"{request.get_method()} {request.full_url} failed: {error}")
            delay = None
        time.sleep(float(delay) if delay and delay.isdigit() else 2 ** attempt * random.uniform(0.5, 1))


def api(method, path, data=None, **params):
    url = API + path + ("?" + urllib.parse.urlencode(params) if params else "")
    body = json.dumps({"data": data}).encode() if data else None
    records = []
    while True:
        response = send(urllib.request.Request(url, body, method=method, headers={
            "Authorization": f"Bearer {token()}", "Content-Type": "application/json"}))
        if not response:
            return None
        document = json.loads(response)
        if not isinstance(document["data"], list):
            return document["data"]
        records.extend(document["data"])
        url = document.get("links", {}).get("next")
        if not url:
            return records


def link(kind, identifier):
    return {"data": {"type": kind, "id": identifier}}


def parse(version):
    return tuple(int(part) for part in version.split("."))


def draft_version(app, version, build):
    versions = api("GET", f"apps/{app}/appStoreVersions", **{"filter[platform]": "IOS", "limit": 200})
    unreleased = [v for v in versions if v["attributes"]["appVersionState"] not in RELEASED]
    if not unreleased:
        return api("POST", "appStoreVersions", {"type": "appStoreVersions",
                   "attributes": {"platform": "IOS", "versionString": version, "releaseType": "MANUAL"},
                   "relationships": {"app": link("apps", app)}})["id"], False
    draft = unreleased[0]
    state, name = draft["attributes"]["appVersionState"], draft["attributes"]["versionString"]
    if parse(name) > parse(version):
        sys.exit(f"App Store version {name} is newer than {version}.")
    if state in IN_REVIEW and name == version:
        print(f"::notice::App Store version {version} is already {state}.", file=sys.stderr)
        return None, False
    if state == "READY_FOR_REVIEW" and name == version and (api("GET", f"appStoreVersions/{draft['id']}/build") or {}).get("id") == build:
        return draft["id"], True
    if state in IN_REVIEW | {"READY_FOR_REVIEW"}:
        withdraw(app, draft["id"], name)
    elif state not in EDITABLE:
        print(f"::notice::App Store version {name} is {state}; preparation of {version} is pending until it is released.", file=sys.stderr)
        return None, False
    updated = api("PATCH", f"appStoreVersions/{draft['id']}", {"type": "appStoreVersions", "id": draft["id"],
                  "attributes": {"releaseType": "MANUAL"} | ({"versionString": version} if name != version else {})})
    if (updated["attributes"]["versionString"], updated["attributes"]["releaseType"]) != (version, "MANUAL"):
        sys.exit(f"App Store Connect kept {name} as {updated['attributes']['versionString']} with release type {updated['attributes']['releaseType']}.")
    return draft["id"], False


def submission_for(app, version_id):
    submissions = [s for s in api("GET", "reviewSubmissions", limit=200, include="appStoreVersionForReview",
                                  **{"filter[app]": app, "filter[platform]": "IOS", "filter[state]": OPEN_SUBMISSIONS})
                   if (s["relationships"]["appStoreVersionForReview"].get("data") or {}).get("id") == version_id]
    if len(submissions) > 1:
        sys.exit(f"App Store Connect shows {len(submissions)} open review submissions for one App Store version; inspect App Review.")
    return submissions[0] if submissions else None


def version_items(submission, version_id):
    return [item for item in api("GET", f"reviewSubmissions/{submission}/items", limit=200, include="appStoreVersion")
            if (item["relationships"]["appStoreVersion"].get("data") or {}).get("id") == version_id]


def withdraw(app, version_id, name):
    submission = submission_for(app, version_id)
    state = submission and submission["attributes"]["state"]
    if state == "READY_FOR_REVIEW":
        for item in version_items(submission["id"], version_id):
            api("DELETE", f"reviewSubmissionItems/{item['id']}")
    elif state == "UNRESOLVED_ISSUES":
        for item in version_items(submission["id"], version_id):
            api("PATCH", f"reviewSubmissionItems/{item['id']}", {"type": "reviewSubmissionItems", "id": item["id"], "attributes": {"removed": True}})
    elif state in IN_REVIEW:
        api("PATCH", f"reviewSubmissions/{submission['id']}", {"type": "reviewSubmissions", "id": submission["id"], "attributes": {"canceled": True}})
    elif state != "CANCELING":
        sys.exit(f"App Store version {name} is in review, but its review submission is {state or 'missing'}; inspect App Review.")
    wait(f"Removing {name} from review", lambda: api("GET", f"appStoreVersions/{version_id}")["attributes"]["appVersionState"] in EDITABLE or None)
    print(f"Removed App Store version {name} from review.", file=sys.stderr)


def submit_for_review(app, version_id, version):
    submission = submission_for(app, version_id)
    if submission:
        for item in version_items(submission["id"], version_id):
            if item["attributes"]["state"] == "REJECTED":
                api("PATCH", f"reviewSubmissionItems/{item['id']}", {"type": "reviewSubmissionItems", "id": item["id"], "attributes": {"resolved": True}})
    else:
        drafts = [draft for draft in api("GET", "reviewSubmissions", limit=200, **{"filter[app]": app, "filter[platform]": "IOS", "filter[state]": "READY_FOR_REVIEW"})
                  if not api("GET", f"reviewSubmissions/{draft['id']}/items", limit=1)]
        submission = drafts[0] if drafts else api("POST", "reviewSubmissions", {"type": "reviewSubmissions",
            "attributes": {"platform": "IOS"}, "relationships": {"app": link("apps", app)}})
        api("POST", "reviewSubmissionItems", {"type": "reviewSubmissionItems", "relationships": {
            "reviewSubmission": link("reviewSubmissions", submission["id"]), "appStoreVersion": link("appStoreVersions", version_id)}})
    api("PATCH", f"reviewSubmissions/{submission['id']}", {"type": "reviewSubmissions", "id": submission["id"], "attributes": {"submitted": True}})
    print(f"Submitted App Store version {version} for App Review.", file=sys.stderr)


def upload(library, slide, created):
    contents = slide.read_bytes()
    image = api("POST", "appAssetLibraryImages", {"type": "appAssetLibraryImages",
                "attributes": {"fileName": slide.name, "fileSize": len(contents), "category": "APP_SCREENSHOTS_AND_PREVIEWS"},
                "relationships": {"assetLibrary": link("appAssetLibraries", library)}})
    created.put(image["id"])
    for part in image["attributes"]["uploadOperations"]:
        send(urllib.request.Request(part["url"], contents[part["offset"]:part["offset"] + part["length"]], method=part["method"],
                                    headers={header["name"]: header["value"] for header in part["requestHeaders"]}))
    api("PATCH", f"appAssetLibraryImages/{image['id']}", {"type": "appAssetLibraryImages", "id": image["id"], "attributes": {"uploaded": True}})
    return image["id"]


def place(localization, images):
    old = api("GET", f"appStoreVersionLocalizations/{localization}/placements", limit=50, include="image",
              **{f"filter[{key}]": value for key, value in SCREENSHOTS.items()})
    displaced = {p["relationships"]["image"]["data"]["id"] for p in old}
    for placement in old:
        api("DELETE", f"appAssetLibraryPlacements/{placement['id']}")
    placements = [api("POST", "appAssetLibraryPlacements", {"type": "appAssetLibraryPlacements", "attributes": SCREENSHOTS,
                      "relationships": {"image": link("appAssetLibraryImages", image),
                                        "appStoreVersionLocalization": link("appStoreVersionLocalizations", localization)}})["id"]
                  for image in images]
    api("POST", "appAssetLibraryPlacementOrderingRequests", {"type": "appAssetLibraryPlacementOrderingRequests",
        "attributes": {"placementGroup": SCREENSHOTS["placementGroup"]},
        "relationships": {"orderedPlacements": {"data": [{"type": "appAssetLibraryPlacements", "id": p} for p in placements]},
                          "appStoreVersionLocalization": link("appStoreVersionLocalizations", localization)}})
    return placements, displaced


def delete_unplaced(images):
    for image in images:
        placements = api("GET", f"appAssetLibraryImages/{image}", include="placements", **{"limit[placements]": 1})
        if not placements["relationships"]["placements"]["data"]:
            try:
                api("DELETE", f"appAssetLibraryImages/{image}")
            except RequestFailed as failure:
                if "ASSET_PREVIOUSLY_SUBMITTED_FOR_REVIEW" not in str(failure):
                    raise


def wait(description, check):
    while (result := check()) is None:
        if time.monotonic() > DEADLINE:
            sys.exit(f"{description} did not finish processing within 40 minutes of the start.")
        time.sleep(20)
    return result


def uploaded_build_numbers(app, version):
    builds = api("GET", "builds", **{"filter[app]": app, "filter[preReleaseVersion.version]": version,
                 "filter[preReleaseVersion.platform]": "IOS", "fields[builds]": "version", "limit": 200})
    uploads = api("GET", f"apps/{app}/buildUploads", **{"filter[cfBundleShortVersionString]": version, "filter[platform]": "IOS",
                  "fields[buildUploads]": "cfBundleVersion,state", "limit": 200})
    return [b["attributes"]["version"] for b in builds] + [u["attributes"]["cfBundleVersion"] for u in uploads
                                                           if u["attributes"]["state"]["state"] in {"PROCESSING", "COMPLETE"}]


def reserve_build(app, version, reserved, fenced):
    if not fenced:
        return max(next_build_number(app), int(reserved)), False
    deadline = time.monotonic() + 15 * 60
    while not (numbers := [int(number) for number in uploaded_build_numbers(app, version) if int(number) >= int(reserved)]):
        if time.monotonic() >= deadline:
            sys.exit(f"An earlier attempt started uploading {version}, but App Store Connect shows no build for it after 15 minutes. Inspect App Store Connect; do not upload again blindly.")
        time.sleep(20)
    return max(numbers), True


def next_build_number(app):
    builds = api("GET", "builds", **{"filter[app]": app, "fields[builds]": "version", "limit": 200})
    uploads = api("GET", f"apps/{app}/buildUploads", **{"fields[buildUploads]": "cfBundleVersion", "limit": 200})
    versions = [b["attributes"]["version"] for b in builds] + [u["attributes"]["cfBundleVersion"] for u in uploads]
    if any(not version.isdecimal() for version in versions):
        sys.exit("Use integer build numbers; App Store Connect contains a non-integer build version.")
    return max((int(version) for version in versions), default=0) + 1


def processed_build(app, version, number):
    builds = api("GET", "builds", sort="-uploadedDate", limit=1, **{"filter[app]": app, "filter[preReleaseVersion.version]": version,
                 "filter[preReleaseVersion.platform]": "IOS", "filter[version]": number, "filter[buildAudienceType]": "APP_STORE_ELIGIBLE"})
    if not builds:
        uploads = api("GET", f"apps/{app}/buildUploads", sort="-uploadedDate", limit=1,
                      **{"filter[cfBundleShortVersionString]": version, "filter[cfBundleVersion]": number, "filter[platform]": "IOS"})
        if uploads and (upload := uploads[0]["attributes"]["state"])["state"] == "FAILED":
            sys.exit(f"App Store Connect rejected the {version} ({number}) upload: "
                     + "; ".join(f"{error['code']} {error['description']}" for error in upload["errors"]))
        return None
    state = builds[0]["attributes"]["processingState"]
    if state in {"FAILED", "INVALID"}:
        sys.exit(f"The {version} build is {state}.")
    return builds[0]["id"] if state == "VALID" else None


def submit_beta(app, version, build, notes):
    localizations = api("GET", f"builds/{build}/betaBuildLocalizations", limit=50)
    if not localizations:
        locale = api("GET", f"apps/{app}")["attributes"]["primaryLocale"]
        api("POST", "betaBuildLocalizations", {"type": "betaBuildLocalizations",
            "attributes": {"locale": locale, "whatsNew": notes}, "relationships": {"build": link("builds", build)}})
    for localization in localizations:
        api("PATCH", f"betaBuildLocalizations/{localization['id']}", {"type": "betaBuildLocalizations",
            "id": localization["id"], "attributes": {"whatsNew": notes}})
    groups = api("GET", "betaGroups", limit=200, **{"filter[app]": app, "filter[isInternalGroup]": "false"})
    if not groups:
        print(f"The {version} build reaches the internal testers; the app has no external group to submit it to.", file=sys.stderr)
        return
    latest = api("GET", f"apps/{app}/appStoreVersions", limit=1, **{"filter[platform]": "IOS"})[0]["id"]
    review_notes = api("GET", f"appStoreVersions/{latest}/appStoreReviewDetail")["attributes"]["notes"]
    api("PATCH", f"betaAppReviewDetails/{app}", {"type": "betaAppReviewDetails", "id": app, "attributes": {"notes": review_notes}})
    api("POST", f"builds/{build}/relationships/betaGroups", [{"type": "betaGroups", "id": g["id"]} for g in groups])
    state = api("GET", f"builds/{build}/buildBetaDetail")["attributes"]["externalBuildState"]
    if state == "READY_FOR_BETA_SUBMISSION":
        api("POST", "betaAppReviewSubmissions", {"type": "betaAppReviewSubmissions", "relationships": {"build": link("builds", build)}})
        print(f"Submitted the {version} build for TestFlight review for {', '.join(g['attributes']['name'] for g in groups)}.", file=sys.stderr)
    elif state in IN_BETA:
        print(f"The {version} build is already {state} in TestFlight.", file=sys.stderr)
    else:
        sys.exit(f"The {version} build is {state} in TestFlight, so it cannot go to external testers.")


def wait_for_screenshots(placements):
    ready = {"ACTIVE", "PARENT_PREPARE_FOR_SUBMISSION", "PARENT_READY_FOR_REVIEW",
             "PARENT_WAITING_FOR_REVIEW", "PARENT_IN_REVIEW", "PARENT_APPROVED"}
    while True:
        attributes = {p: api("GET", f"appAssetLibraryPlacements/{p}")["attributes"] for p in placements}
        failed = [a["stateDetails"] for a in attributes.values() if a["state"] == "FAILED"]
        if failed:
            sys.exit(f"App Store Connect could not process a screenshot: {failed}")
        states = {p: a["state"] for p, a in attributes.items()}
        if all(state in ready for state in states.values()):
            return
        if time.monotonic() > DEADLINE:
            sys.exit(f"The screenshots did not finish processing within 40 minutes of the start. Last placement states: {states}.")
        time.sleep(20)


def testflight(app, version, number, notes):
    build = wait(f"The {version} build", lambda: processed_build(app, version, number))
    submit_beta(app, version, build, notes)


def app_store(app, version, number, screenshots, notes):
    slides = sorted(Path(screenshots).glob("*.png"))
    if not 1 <= len(slides) <= 10:
        sys.exit("Provide 1–10 PNG screenshots.")
    build = wait(f"The {version} build", lambda: processed_build(app, version, number))
    version_id, prepared = draft_version(app, version, build)
    if version_id is None:
        return
    if not prepared:
        prepare(app, version_id, build, slides, notes)
    submit_for_review(app, version_id, version)


def prepare(app, version_id, build, slides, notes):
    library = api("GET", f"apps/{app}/assetLibrary")["id"]
    created = queue.SimpleQueue()
    placements, displaced = [], set()
    try:
        with concurrent.futures.ThreadPoolExecutor(len(slides)) as pool:
            images = list(pool.map(lambda slide: upload(library, slide, created), slides))
        for localization in api("GET", f"appStoreVersions/{version_id}/appStoreVersionLocalizations", limit=50):
            api("PATCH", f"appStoreVersionLocalizations/{localization['id']}", {"type": "appStoreVersionLocalizations",
                "id": localization["id"], "attributes": {"whatsNew": notes}})
            placed, replaced = place(localization["id"], images)
            placements += placed
            displaced |= replaced
            print(f"Placed {len(images)} screenshots on {localization['attributes']['locale']}.", file=sys.stderr)
    except BaseException:
        try:
            reserved = []
            while not created.empty():
                reserved.append(created.get_nowait())
            delete_unplaced(reserved)
        except RequestFailed as failure:
            print(f"Could not remove this run's unplaced screenshots: {failure}", file=sys.stderr)
        raise
    delete_unplaced(displaced)
    api("PATCH", f"appStoreVersions/{version_id}/relationships/build", {"type": "builds", "id": build})
    wait_for_screenshots(placements)


def main(command, *arguments):
    missing = [name for name in ("APP_STORE_CONNECT_KEY_ID", "APP_STORE_CONNECT_ISSUER_ID", "APP_STORE_CONNECT_KEY_PATH", "LYKTA_BUNDLE_ID")
               if not os.environ.get(name)]
    if missing:
        sys.exit(f"Set {', '.join(missing)}.")
    apps = api("GET", "apps", **{"filter[bundleId]": os.environ["LYKTA_BUNDLE_ID"]})
    if not apps:
        sys.exit(f"No app has the bundle ID {os.environ['LYKTA_BUNDLE_ID']}.")
    if command == "next-build-number":
        print(next_build_number(apps[0]["id"]))
        return
    if command == "build-number":
        version, reserved, fence = arguments
        if fence not in {"fenced", "open"}:
            sys.exit("The upload fence must be fenced or open.")
        if not reserved.isdigit():
            sys.exit("The reserved build number must be an integer.")
        number, uploaded = reserve_build(apps[0]["id"], version, reserved, fence == "fenced")
        print(number, "uploaded" if uploaded else "new")
        return
    version, number, *paths = arguments
    notes = Path(paths[-1]).read_text().strip()
    if command == "testflight":
        testflight(apps[0]["id"], version, number, notes)
    else:
        app_store(apps[0]["id"], version, number, paths[0], notes)


if __name__ == "__main__":
    counts = {"next-build-number": 2, "build-number": 5, "testflight": 5, "app-store": 6}
    if len(sys.argv) != counts.get(sys.argv[1] if len(sys.argv) > 1 else "", 0):
        sys.exit("Usage: scripts/app-store-connect next-build-number\n       scripts/app-store-connect build-number VERSION RESERVED fenced|open\n       scripts/app-store-connect testflight VERSION BUILD NOTES\n       scripts/app-store-connect app-store VERSION BUILD SCREENSHOTS NOTES")
    try:
        main(*sys.argv[1:])
    except RequestFailed as failure:
        sys.exit(str(failure))
