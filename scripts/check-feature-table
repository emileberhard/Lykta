#!/usr/bin/env python3
import re
import subprocess
import sys

TABLE = "Core/Sources/LyktaCore/Compatibility.swift"
VERSION = re.compile(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)")


def parse(text):
    return tuple(int(part) for part in text.split("."))


def table(revision):
    shown = subprocess.run(["git", "show", f"{revision}:{TABLE}"], capture_output=True, text=True)
    if shown.returncode != 0:
        return None
    block = re.search(r"static let introduced\b.*?\]\.flatMap", shown.stdout, re.S)
    if block is None:
        sys.exit(f"{revision}:{TABLE} has no Layout.introduced table this script can read.")
    rows = re.findall(r'"(\d+\.\d+\.\d+)": \[(.*?)\]', block.group(0), re.S)
    return {row: set(re.findall(r'"([^"]+)"', features)) for row, features in rows}


def main(tag):
    if not VERSION.fullmatch(tag):
        sys.exit(f"{tag} is not MAJOR.MINOR.PATCH.")
    current = table("HEAD")
    if not current:
        sys.exit(f"HEAD has no {TABLE}.")
    tags = subprocess.run(["git", "tag", "--list"], capture_output=True, text=True, check=True).stdout.split()
    older = sorted((t for t in tags if VERSION.fullmatch(t) and parse(t) < parse(tag)), key=parse)
    previous_tag = older[-1] if older else None
    previous = table(previous_tag) if previous_tag else None
    errors = [f"Row {row} is newer than {tag}." for row in current if parse(row) > parse(tag)]
    if previous is not None:
        released = set(previous) | {row for row in current if parse(row) <= parse(previous_tag)}
        errors += [f"Row {row} differs from {previous_tag}; released rows never change." for row in sorted(released, key=parse)
                   if previous.get(row) != current.get(row)]
    for row in sorted(current, key=parse):
        if previous_tag is None or parse(row) > parse(previous_tag):
            if row != tag:
                errors.append(f"Row {row} is new since {previous_tag}; new features belong in a row for this release, {tag}.")
            elif parse(tag)[2] != 0:
                major, minor, _ = parse(tag)
                errors.append(f"{tag} adds layout features, which ship only in a minor release; tag {major}.{minor + 1}.0 instead.")
    if errors:
        sys.exit("\n".join(errors))
    print(f"Layout feature table is consistent with {tag} (previous release {previous_tag}).")


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: scripts/check-feature-table VERSION")
    main(sys.argv[1])
