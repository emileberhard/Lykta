{
  "configurations": [
    { "name": "Debug", "file": "Config/Lykta.xcconfig" },
    { "name": "Release", "file": "Config/Lykta.xcconfig" }
  ],
  "packages": [
    { "kind": "local", "path": "Core" }
  ],
  "files": [
    { "kind": "folder", "path": "App", "target-membership": ["Lykta"] },
    { "kind": "folder", "path": "Widgets", "target-membership": ["LyktaWidgets"] },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Lykta.xcconfig" },
        { "path": "App.plist" },
        { "path": "Widgets.plist" },
        { "path": "Lykta.entitlements" }
      ]
    },
    {
      "kind": "group",
      "path": "Products",
      "children": [
        { "path": "Lykta.app", "id": "LYKTAAPPPRODUCT000000001", "type": "wrapper.application" },
        {
          "path": "LyktaWidgets.appex",
          "id": "LYKTAWIDGETSPRODUCT00001",
          "type": "wrapper.app-extension",
          "target-membership": [
            { "build-phase": "Lykta/copy/Embed Foundation Extensions", "code-sign-on-copy": true }
          ]
        }
      ]
    }
  ],
  "targets": [
    {
      "name": "Lykta",
      "id": "LYKTAAPPTARGET0000000001",
      "product": "Products/Lykta.app",
      "product-type": "application",
      "dependencies": [
        "LyktaWidgets",
        { "kind": "package", "product-name": "LyktaCore" }
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        { "kind": "copy", "name": "Embed Foundation Extensions", "bundle-base-path": "plugins-directory" }
      ],
      "package-product-members": [
        { "product-name": "LyktaCore", "build-phase": { "build-phase": "frameworks" } }
      ],
      "build-settings": {
        "PRODUCT_NAME": "Lykta",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(LYKTA_BUNDLE_ID)",
        "INFOPLIST_FILE": "Config/App.plist",
        "CODE_SIGN_ENTITLEMENTS": "Config/Lykta.entitlements",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "LD_RUNPATH_SEARCH_PATHS": ["$(inherited)", "@executable_path/Frameworks"]
      }
    },
    {
      "name": "LyktaWidgets",
      "id": "LYKTAWIDGETSTARGET000001",
      "product": "Products/LyktaWidgets.appex",
      "product-type": "app-extension",
      "dependencies": [
        { "kind": "package", "product-name": "LyktaCore" }
      ],
      "build-phases": ["compile-sources", "frameworks", "resources"],
      "package-product-members": [
        { "product-name": "LyktaCore", "build-phase": { "build-phase": "frameworks" } }
      ],
      "build-settings": {
        "PRODUCT_NAME": "LyktaWidgets",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(LYKTA_BUNDLE_ID).widgets",
        "INFOPLIST_FILE": "Config/Widgets.plist",
        "SKIP_INSTALL": "YES",
        "LD_RUNPATH_SEARCH_PATHS": ["$(inherited)", "@executable_path/Frameworks", "@executable_path/../../Frameworks"]
      }
    }
  ]
}
